# 繁體中文 OpenCV 展示：變數、函式、功能參數與介面均使用中文。
變數 視覺 = 匯入("/bottles/Aqua_OpenCV/main.aqua");
變數 功能清單 = 匯入("功能清單.aqua");
變數 功能項目=功能清單.功能項目;
變數 繪圖 = 匯入("繪圖");
變數 序列化 = 匯入("序列化");
變數 陣列 = 匯入("陣列");
變數 檔案 = 匯入("Files");
變數 應用程式 = 匯入("Application");
變數 功能資訊 = 視覺.功能支援();
變數 已選功能 = 5;
變數 頁碼 = 0;
變數 閾值 = 100;
變數 核心大小 = 5;
變數 需要更新 = 真;
變數 輸入影像 = 0;
變數 肖像影像 = 0;
變數 輸出影像 = 0;
變數 原圖預覽 = 0;
變數 結果預覽 = 0;
變數 上次來源 = 0;
變數 使用肖像 = 真;
變數 狀態 = "選擇左側功能，即可處理影像。";
變數 統計 = "";
變數 處理毫秒 = 0.0d;
變數 縮放比例 = 1.0d;
變數 水平位移 = 0.0d;
變數 垂直位移 = 0.0d;
變數 支援功能 = 函式(功能名稱) { 回傳 陣列.包含(功能資訊["功能"],功能名稱); };
變數 更新結果 = 函式() {
    需要更新=假;
    變數 項目=功能項目[已選功能];
    如果(輸出影像!=0){視覺.釋放影像(輸出影像);輸出影像=0;}
    結果預覽=0;
    如果(!支援功能(項目[0])){狀態="此功能需要原生 OpenCV 後端。";統計="目前後端未提供此功能，請使用 Windows 或 Android 原生版。";回傳 0;}
    變數 來源=輸入影像;
    如果(使用肖像 && (項目[0]=="人臉偵測" || 項目[0]=="神經網路人臉")){
        如果(肖像影像==0){肖像影像=視覺.載入("/bottles/Aqua_OpenCV/assets/portrait.jpg");}
        來源=肖像影像;
    }
    如果(來源!=上次來源){原圖預覽=視覺.預覽(來源);上次來源=來源;}
    變數 回應=視覺.處理(來源,項目[0],{"閾值":閾值,"核心大小":核心大小,"角度":閾值/5.0d});
    如果(回應["成功"]){
        輸出影像=回應["結果"]["影像"];
        處理毫秒=回應["結果"]["毫秒"];
        統計=序列化.JSON序列化(回應["結果"]["統計"]);
        結果預覽=視覺.預覽(輸出影像);
        狀態="處理完成。連續運算時，影像資料保留於 OpenCV 記憶體中。";
    }否則{狀態="無法處理此影像，請調整參數或更換影像。";統計=回應["錯誤"];}
};
變數 選取功能 = 函式(索引){已選功能=索引;如果(已選功能<0){已選功能=長度(功能項目)-1;}如果(已選功能>=長度(功能項目)){已選功能=0;}頁碼=繪圖.向下取整(已選功能/15.0d);需要更新=真;};
變數 按鈕 = 函式(標題,橫座標,縱座標,寬度,已啟用){繪圖.停用描邊();如果(已啟用){繪圖.填色(39,99,101);}否則{繪圖.填色(31,44,59);}繪圖.矩形(橫座標,縱座標,寬度,34,7);繪圖.填色(224,235,244);繪圖.文字大小(12);繪圖.文字(標題,橫座標+12,縱座標+22);};
變數 初始化 = 函式(){
    繪圖.尺寸(1280,850,繪圖.P2D,"Aquarius｜OpenCV 視覺實驗室");繪圖.影格率(30);繪圖.文字字型(繪圖.建立字型("Microsoft JhengHei",14));
    輸入影像=視覺.範例影像(12);
    視覺.載入人臉分類器("/bottles/Aqua_OpenCV/assets/face.xml");
    如果(支援功能("神經網路人臉")){視覺.載入神經網路("/bottles/Aqua_OpenCV/assets/yunet.onnx");}
    繪圖.註冊事件("keyPressed",函式(){如果(繪圖.keyCode==262 || 繪圖.keyCode==39){選取功能(已選功能+1);}如果(繪圖.keyCode==263 || 繪圖.keyCode==37){選取功能(已選功能-1);}如果(繪圖.keyCode==32){需要更新=真;}});
    繪圖.註冊事件("mousePressed",函式(){
        變數 橫座標=(繪圖.mouseX-水平位移)/縮放比例;變數 縱座標=(繪圖.mouseY-垂直位移)/縮放比例;
        如果(橫座標>=24 && 橫座標<270 && 縱座標>=160 && 縱座標<700){變數 索引=頁碼*15+繪圖.向下取整((縱座標-160)/36.0d);如果(索引<長度(功能項目)){選取功能(索引);}}
        如果(縱座標>=723 && 縱座標<=757 && 橫座標>=24 && 橫座標<140){頁碼=頁碼-1;如果(頁碼<0){頁碼=2;}}
        如果(縱座標>=723 && 縱座標<=757 && 橫座標>=152 && 橫座標<270){頁碼=頁碼+1;如果(頁碼>2){頁碼=0;}}
        如果(縱座標>=691 && 縱座標<725 && 橫座標>=330 && 橫座標<=1050){閾值=繪圖.四捨五入((橫座標-330)/720.0d*255);需要更新=真;}
        如果(縱座標>=742 && 縱座標<776 && 橫座標>=330 && 橫座標<470){核心大小=核心大小+2;如果(核心大小>15){核心大小=1;}需要更新=真;}
        如果(縱座標>=742 && 縱座標<776 && 橫座標>=485 && 橫座標<625){需要更新=真;}
        如果(縱座標>=742 && 縱座標<776 && 橫座標>=640 && 橫座標<795){
            變數 選取檔案=應用程式.開啟檔案({"title":"開啟影像","multiple":假});
            如果(長度(選取檔案)>0){變數 新影像=視覺.解碼(檔案.讀取位元組(選取檔案[0]));視覺.釋放影像(輸入影像);輸入影像=新影像;使用肖像=假;上次來源=0;需要更新=真;}
        }
        如果(縱座標>=742 && 縱座標<776 && 橫座標>=810 && 橫座標<965 && 輸出影像!=0){
            變數 儲存資源=應用程式.儲存檔案({"suggestedName":"OpenCV處理結果.png"});
            如果(儲存資源){檔案.儲存位元組(儲存資源,視覺.編碼PNG(輸出影像));狀態="已儲存 PNG 影像。";}
        }
        如果(縱座標>=742 && 縱座標<776 && 橫座標>=980 && 橫座標<1135){視覺.釋放影像(輸入影像);輸入影像=視覺.範例影像(12);使用肖像=真;上次來源=0;需要更新=真;}
    });
};
變數 繪製介面 = 函式(){
    如果(需要更新){更新結果();}
    縮放比例=繪圖.最小值(繪圖.width/1280.0d,繪圖.height/850.0d);水平位移=(繪圖.width-1280*縮放比例)/2;垂直位移=(繪圖.height-850*縮放比例)/2;
    繪圖.背景(11,18,29);繪圖.推入狀態();繪圖.平移(水平位移,垂直位移);繪圖.縮放(縮放比例);
    繪圖.停用描邊();繪圖.填色(18,29,43);繪圖.矩形(0,0,1280,112);繪圖.填色(74,222,190);繪圖.文字大小(12);繪圖.文字("AQUARIUS / 電腦視覺",24,30);
    繪圖.填色(237,244,251);繪圖.文字大小(28);繪圖.文字("OpenCV 視覺實驗室",24,67);
    繪圖.填色(142,163,184);繪圖.文字大小(12);繪圖.文字("45 項視覺實驗  /  真實 OpenCV 演算法  /  Bottle 跨平台函式庫",24,93);
    繪圖.填色(160,181,196);繪圖.文字大小(11);繪圖.文字("OpenCV " + 功能資訊["版本"],1010,39);繪圖.文字(功能資訊["後端"],780,66);
    繪圖.填色(18,29,43);繪圖.矩形(12,126,270,662,12);繪圖.填色(94,117,141);繪圖.文字大小(11);繪圖.文字("探索功能  /  第 " + 序列化.JSON序列化(頁碼+1) + " / 3 頁",24,148);
    迴圈(變數 列=0;列<15;列++){
        變數 序號=頁碼*15+列;
        如果(序號<長度(功能項目)){
            變數 縱座標=160+列*36;
            如果(序號==已選功能){繪圖.填色(32,74,80);繪圖.矩形(22,縱座標,248,33,6);}
            如果(支援功能(功能項目[序號][0])){繪圖.填色(213,227,239);}否則{繪圖.填色(93,112,133);}
            繪圖.文字大小(12);繪圖.文字(功能項目[序號][1],34,縱座標+21);
        }
    }
    按鈕("上一頁",24,723,116,假);按鈕("下一頁",152,723,116,假);
    變數 項目=功能項目[已選功能];繪圖.填色(74,222,190);繪圖.文字大小(11);繪圖.文字(項目[2],310,151);繪圖.填色(237,244,251);繪圖.文字大小(25);繪圖.文字(項目[1],310,185);
    繪圖.填色(149,171,191);繪圖.文字大小(13);繪圖.文字(項目[3],310,211);
    繪圖.填色(23,35,50);繪圖.矩形(310,237,450,350,10);繪圖.矩形(782,237,474,350,10);
    繪圖.填色(122,146,168);繪圖.文字大小(11);繪圖.文字("原始影像",326,260);繪圖.文字("處理結果",798,260);
    如果(原圖預覽!=0){繪圖.圖片(原圖預覽,326,279,418,284);}
    如果(結果預覽!=0){繪圖.圖片(結果預覽,798,279,442,284);}否則{繪圖.填色(118,141,162);繪圖.文字大小(14);繪圖.文字("請選擇目前後端支援的功能",828,420);}
    繪圖.填色(74,222,190);繪圖.文字大小(12);繪圖.文字("演算法耗時：" + 序列化.JSON序列化(繪圖.四捨五入(處理毫秒*100)/100.0d) + " 毫秒",310,619);
    繪圖.填色(146,169,188);繪圖.文字大小(12);繪圖.文字(統計,310,645);
    繪圖.填色(94,117,141);繪圖.文字大小(11);繪圖.文字("閾值 / 旋轉角度參數",310,680);
    繪圖.描邊(47,66,84);繪圖.描邊粗細(5);繪圖.線段(330,707,1050,707);繪圖.描邊(74,222,190);繪圖.線段(330,707,330+720*閾值/255.0d,707);繪圖.停用描邊();繪圖.填色(74,222,190);繪圖.圓形(330+720*閾值/255.0d,707,13);繪圖.填色(215,229,239);繪圖.文字大小(12);繪圖.文字(序列化.JSON序列化(閾值),1090,712);
    按鈕("核心："+序列化.JSON序列化(核心大小),330,742,140,真);按鈕("重新處理",485,742,140,假);按鈕("開啟影像",640,742,155,假);按鈕("儲存 PNG",810,742,155,假);按鈕("重設範例",980,742,155,假);
    繪圖.填色(115,142,163);繪圖.文字大小(11);繪圖.文字(狀態,310,806);繪圖.文字("方向鍵：切換功能　空白鍵：重新處理　灰色項目需要原生 OpenCV。",310,830);
    繪圖.彈出狀態();
};
繪圖.執行(初始化,繪製介面);
視覺.釋放();
